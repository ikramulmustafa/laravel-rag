# Keep the distributed package to what an application actually needs at runtime.
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpstan.neon       export-ignore
/pint.json          export-ignore
/CONTRIBUTING.md    export-ignore
/CHANGELOG.md       export-ignore
/SECURITY.md        export-ignore

# Normalise line endings so a checkout on Windows does not reformat the tree.
* text=auto eol=lf
*.md    text
*.php   text
*.json  text
*.yml   text
